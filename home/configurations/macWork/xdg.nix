{
  config,
  ...
}:
let
  hmBrewfile = "homebrew/HomeManagerBrewfile";
in
{
  xdg.configFile."${hmBrewfile}".text = ''
    # THIS FILE IS GENERATED BY HOME-MANAGER, DO NOT EDIT DIRECTLY

    # keep-sorted start
    brew "crit"               # Your feedback loop with the agent: review plans and code locally
    cask "alt-tab"            # Window switcher, Windows/Linux-style
    cask "bruno"              # Open source IDE for exploring and testing APIs
    cask "ghostty"            # Terminal emulator that uses platform-native UI and GPU acceleration
    cask "karabiner-elements" # Keyboard customiser
    cask "macshot"            # Screenshot and screen recording tool
    cask "middleclick"        # Utility to extend trackpad functionality
    cask "mos"                # Smooths scrolling and set mouse scroll directions independently
    cask "obsidian"           # Knowledge base that works on top of a local folder of plain text Markdown files
    cask "thaw"               # Menu bar manager
    # keep-sorted end
  '';

  home.shellAliases.brew_bundle = "brew bundle cleanup --install --force --verbose --file ${config.xdg.configHome}/${hmBrewfile}";
}
